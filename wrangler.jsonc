{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compassle",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "compassle",
      "database_id": "4c0c589b-0c45-4e0a-9862-7b217d55c0dc",
    },
  ],
}
